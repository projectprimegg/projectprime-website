+using System;
+using System.IO;
+using System.Linq;
+using Avalonia.Controls;
+using MphRead.Mods.MapGen.Universal;
+
+namespace MphRead.Mods.Launcher.Gui;
+
+internal sealed partial class MapStudioScreen
+{
+    private void ShowUniversalImporters()
+    {
+        var panel = new StackPanel { Spacing = 8 };
+        panel.Children.Add(Text("UNIVERSAL MAP IMPORT PIPELINE"));
+        panel.Children.Add(Text("Source adapters feed one UniversalMap representation before Project Prime conversion, validation and editor application."));
+        foreach (var adapter in UniversalMapImportService.Adapters.OrderBy(a => a.FidelityTier).ThenBy(a => a.DisplayName, StringComparer.OrdinalIgnoreCase))
+        {
+            panel.Children.Add(Text($"{adapter.DisplayName} · fidelity tier {adapter.FidelityTier}"));
+            panel.Children.Add(Text("Formats: " + string.Join(", ", adapter.Extensions.OrderBy(x => x, StringComparer.OrdinalIgnoreCase))));
+        }
+        panel.Children.Add(Text("Tier 1 = native map structure; Tier 2 = tool-assisted structured conversion; Tier 3 = generic 3D geometry/material import."));
+        panel.Children.Add(Text("Current testable path: OBJ / glTF / GLB through the Project Prime generic 3D adapter. More source-game adapters should terminate at the same UniversalMap backend."));
+        AddButton(panel, "Import universal 3D…", ImportModel);
+        AddButton(panel, "Close", Dismiss);
+        Modal(panel);
+    }
+}
