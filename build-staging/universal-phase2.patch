+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace MphRead.Mods.MapGen.Universal;
+
+/// <summary>
+/// Common Project Prime backend for UniversalMap. Adapters must not bypass
+/// this seam; future normalization, repair, validation and provenance hooks
+/// belong here or before it.
+/// </summary>
+public static class UniversalMapProjectPrimeBackend
+{
+    public static ImportedModel ToImportedModel(UniversalImportResult source)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        var definition = CreateProject(source.Map, source.Map.Name);
+        var meshes = definition.Geometry.OfType<MapMesh>().ToArray();
+        var warnings = source.Map.Diagnostics
+            .Where(d => !string.Equals(d.Severity, "info", StringComparison.OrdinalIgnoreCase))
+            .Select(d => $"[{d.Code}] {d.Message}")
+            .ToArray();
+        return new ImportedModel(meshes, definition.Materials.ToArray(), source.Assets, warnings)
+        {
+            Dependencies = source.Dependencies,
+            AssetSources = source.AssetSources
+        };
+    }
+
+    public static MapDefinition CreateProject(UniversalMap source, string runtimeName, string? author = null)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        if (string.IsNullOrWhiteSpace(runtimeName)) throw new ArgumentException("Runtime map name is required.", nameof(runtimeName));
+
+        var definition = new MapDefinition
+        {
+            FormatVersion = 3,
+            MapId = source.Id,
+            Name = runtimeName.ToUpperInvariant(),
+            InGameName = source.Name,
+            Author = author,
+            FarClip = source.Environment.FarClip,
+            FogEnabled = source.Environment.FogEnabled,
+            FogColor = source.Environment.FogColor.Select(v => (int)Math.Clamp(MathF.Round(v * 31f), 0, 31)).ToArray()
+        };
+
+        foreach (var material in source.Materials)
+        {
+            definition.Materials.Add(new MapMaterial
+            {
+                Id = material.Id,
+                Name = material.Name,
+                Texture = material.NativeTexture,
+                Albedo = material.Albedo,
+                Normal = material.Normal,
+                SpecularRoughness = material.SpecularRoughness,
+                Emissive = material.Emissive,
+                TwoSided = material.TwoSided,
+                Alpha = material.Opacity >= .999f ? null : (int)Math.Clamp(MathF.Round(material.Opacity * 31f), 0, 31),
+                Animation = material.Animation == null ? null : new MapMaterialAnimation
+                {
+                    UvScroll = (float[])material.Animation.Scroll.Clone(),
+                    UvRotationDegreesPerSecond = material.Animation.RotationDegreesPerSecond,
+                    UvScale = (float[])material.Animation.Scale.Clone(),
+                    UvScalePulse = (float[])material.Animation.ScalePulse.Clone(),
+                    EmissiveIntensity = material.Animation.EmissiveIntensity,
+                    EmissivePulse = material.Animation.EmissivePulse,
+                    LoopFrames = Math.Max(1, (int)MathF.Round(material.Animation.LoopSeconds * 30f))
+                }
+            });
+        }
+
+        foreach (var mesh in source.RenderMeshes.Concat(source.CollisionMeshes))
+        {
+            var target = new MapMesh
+            {
+                Id = mesh.Id,
+                Label = mesh.Name,
+                CollisionOnly = mesh.CollisionOnly || source.CollisionMeshes.Contains(mesh),
+                Solid = mesh.Solid,
+                Damaging = mesh.Collision.Damaging,
+                Slipperiness = mesh.Collision.Slipperiness,
+                IgnorePlayers = !mesh.Collision.BlocksPlayers,
+                IgnoreBeams = !mesh.Collision.BlocksProjectiles,
+                IgnoreScan = !mesh.Collision.BlocksScan,
+                Terrain = mesh.Collision.Terrain,
+                Transform = new MapTransform
+                {
+                    Position = (float[])mesh.Transform.Position.Clone(),
+                    Rotation = (float[])mesh.Transform.Rotation.Clone(),
+                    Scale = (float[])mesh.Transform.Scale.Clone()
+                }
+            };
+            target.Vertices.AddRange(mesh.Vertices.Select(v => (float[])v.Clone()));
+            target.Faces.AddRange(mesh.Faces.Select(f => (int[])f.Clone()));
+            target.FaceMaterials.AddRange(mesh.FaceMaterials);
+            target.FaceTexcoords.AddRange(mesh.FaceUv0.Select(face => face == null ? null : face.Select(uv => (float[])uv.Clone()).ToArray()));
+            definition.Geometry.Add(target);
+        }
+
+        return definition;
+    }
+}
