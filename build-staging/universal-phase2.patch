+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+
+namespace MphRead.Mods.MapGen.Universal;
+
+/// <summary>
+/// Tier-3 adapter over Project Prime's already hardened OBJ/glTF importers.
+/// This proves the UniversalMap seam without duplicating parser code.
+/// </summary>
+public sealed class ExistingModelUniversalAdapter : IUniversalMapAdapter
+{
+    private static readonly string[] _extensions = { ".obj", ".gltf", ".glb" };
+    public string Id => "project-prime-model";
+    public string DisplayName => "Project Prime generic 3D";
+    public int FidelityTier => 3;
+    public IReadOnlyCollection<string> Extensions => _extensions;
+    public bool CanImport(string path) => _extensions.Contains(Path.GetExtension(path), StringComparer.OrdinalIgnoreCase);
+
+    public UniversalImportResult Import(string path, UniversalImportOptions options, CancellationToken cancellation = default)
+    {
+        path = Path.GetFullPath(path);
+        var imported = ModelImportService.Import(path, new ModelImportSettings(
+            Scale: options.Scale,
+            FlipWinding: options.FlipWinding,
+            ZUp: options.ZUp,
+            FlipUvVertical: options.FlipUvVertical,
+            Collision: options.Collision), cancellation);
+
+        var map = new UniversalMap
+        {
+            Name = Path.GetFileNameWithoutExtension(path),
+            Source = new UniversalSourceInfo
+            {
+                AdapterId = Id,
+                SourcePath = path,
+                SourceFormat = Path.GetExtension(path).TrimStart('.').ToLowerInvariant(),
+                CoordinateSystem = options.ZUp ? "source Z-up converted to Project Prime" : "source/default",
+                UnitsToMph = options.Scale,
+                Dependencies = imported.Dependencies.ToList()
+            }
+        };
+
+        foreach (var material in imported.Materials)
+        {
+            map.Materials.Add(new UniversalMaterial
+            {
+                Id = material.Id == Guid.Empty ? Guid.NewGuid() : material.Id,
+                Name = material.Name,
+                NativeTexture = material.Texture,
+                Albedo = material.Albedo,
+                Normal = material.Normal,
+                SpecularRoughness = material.SpecularRoughness,
+                Emissive = material.Emissive,
+                TwoSided = material.TwoSided,
+                Opacity = material.Alpha.HasValue ? Math.Clamp(material.Alpha.Value / 31f, 0f, 1f) : 1f,
+                Animation = material.Animation == null ? null : new UniversalMaterialAnimation
+                {
+                    Scroll = (float[])material.Animation.UvScroll.Clone(),
+                    RotationDegreesPerSecond = material.Animation.UvRotationDegreesPerSecond,
+                    Scale = (float[])material.Animation.UvScale.Clone(),
+                    ScalePulse = (float[])material.Animation.UvScalePulse.Clone(),
+                    EmissiveIntensity = material.Animation.EmissiveIntensity,
+                    EmissivePulse = material.Animation.EmissivePulse,
+                    LoopSeconds = material.Animation.LoopFrames / 30f
+                },
+                Provenance = new UniversalProvenance { SourceMaterial = material.Name, SourceType = "model-material" }
+            });
+        }
+
+        foreach (var source in imported.Meshes)
+        {
+            var target = new UniversalMesh
+            {
+                Id = source.Id,
+                Name = source.Label,
+                Solid = source.Solid,
+                CollisionOnly = source.CollisionOnly,
+                Transform = new UniversalTransform
+                {
+                    Position = (float[])source.Transform.Position.Clone(),
+                    Rotation = (float[])source.Transform.Rotation.Clone(),
+                    Scale = (float[])source.Transform.Scale.Clone()
+                },
+                Collision = new UniversalCollisionFlags
+                {
+                    BlocksPlayers = !source.IgnorePlayers,
+                    BlocksProjectiles = !source.IgnoreBeams,
+                    BlocksScan = !source.IgnoreScan,
+                    Damaging = source.Damaging,
+                    Slipperiness = source.Slipperiness,
+                    Terrain = source.Terrain
+                },
+                Provenance = new UniversalProvenance { SourceObject = source.Label, SourceType = "model-mesh" }
+            };
+            target.Vertices.AddRange(source.Vertices.Select(v => (float[])v.Clone()));
+            target.Faces.AddRange(source.Faces.Select(f => (int[])f.Clone()));
+            target.FaceMaterials.AddRange(source.FaceMaterials);
+            target.FaceUv0.AddRange(source.FaceTexcoords.Select(face => face == null ? null : face.Select(uv => (float[])uv.Clone()).ToArray()));
+            if (source.CollisionOnly) map.CollisionMeshes.Add(target); else map.RenderMeshes.Add(target);
+        }
+
+        foreach (string warning in imported.Warnings)
+            map.Diagnostics.Add(new UniversalDiagnostic { Code = "UMAP-ADAPTER-WARN", Severity = "warning", Message = warning });
+
+        return new UniversalImportResult(map, imported.Assets, imported.AssetSources, imported.Dependencies);
+    }
+}
