+using System;
+using System.Collections.Generic;
+
+namespace MphRead.Mods.MapGen.Universal;
+
+/// <summary>
+/// Engine-neutral intermediate representation for imported authored worlds.
+/// Source adapters populate this model; normalization/validation and the
+/// Project Prime backend operate on it without knowing the source game.
+/// </summary>
+public sealed class UniversalMap
+{
+    public int SchemaVersion { get; set; } = 1;
+    public Guid Id { get; set; } = Guid.NewGuid();
+    public string Name { get; set; } = "Imported World";
+    public UniversalSourceInfo Source { get; set; } = new();
+    public UniversalEnvironment Environment { get; set; } = new();
+    public List<UniversalMaterial> Materials { get; set; } = new();
+    public List<UniversalMesh> RenderMeshes { get; set; } = new();
+    public List<UniversalMesh> CollisionMeshes { get; set; } = new();
+    public List<UniversalEntity> Entities { get; set; } = new();
+    public List<UniversalDiagnostic> Diagnostics { get; set; } = new();
+    public Dictionary<string, string> Metadata { get; set; } = new(StringComparer.Ordinal);
+}
+
+public sealed class UniversalSourceInfo
+{
+    public string AdapterId { get; set; } = "unknown";
+    public string AdapterVersion { get; set; } = "1";
+    public string SourcePath { get; set; } = "";
+    public string SourceFormat { get; set; } = "";
+    public string CoordinateSystem { get; set; } = "source";
+    public float UnitsToMph { get; set; } = 1f;
+    public List<string> Dependencies { get; set; } = new();
+}
+
+public sealed class UniversalEnvironment
+{
+    public bool FogEnabled { get; set; }
+    public float[] FogColor { get; set; } = new[] { 0f, 0f, 0f };
+    public string? Sky { get; set; }
+    public float FarClip { get; set; } = 350f;
+    public Dictionary<string, string> Metadata { get; set; } = new(StringComparer.Ordinal);
+}
+
+public sealed class UniversalMesh
+{
+    public Guid Id { get; set; } = Guid.NewGuid();
+    public string Name { get; set; } = "Mesh";
+    public UniversalTransform Transform { get; set; } = new();
+    public List<float[]> Vertices { get; set; } = new();
+    public List<int[]> Faces { get; set; } = new();
+    public List<int> FaceMaterials { get; set; } = new();
+    public List<float[][]?> FaceUv0 { get; set; } = new();
+    public List<float[][]?> FaceUv1 { get; set; } = new();
+    public bool Solid { get; set; } = true;
+    public bool CollisionOnly { get; set; }
+    public UniversalCollisionFlags Collision { get; set; } = new();
+    public UniversalProvenance Provenance { get; set; } = new();
+    public Dictionary<string, string> Metadata { get; set; } = new(StringComparer.Ordinal);
+}
+
+public sealed class UniversalTransform
+{
+    public float[] Position { get; set; } = new float[3];
+    public float[] Rotation { get; set; } = new[] { 0f, 0f, 0f, 1f };
+    public float[] Scale { get; set; } = new[] { 1f, 1f, 1f };
+}
+
+public sealed class UniversalCollisionFlags
+{
+    public bool BlocksPlayers { get; set; } = true;
+    public bool BlocksProjectiles { get; set; } = true;
+    public bool BlocksScan { get; set; } = true;
+    public bool Damaging { get; set; }
+    public int Slipperiness { get; set; }
+    public string Terrain { get; set; } = "Metal";
+}
+
+public sealed class UniversalMaterial
+{
+    public Guid Id { get; set; } = Guid.NewGuid();
+    public string Name { get; set; } = "Material";
+    public string? NativeTexture { get; set; }
+    public string? Albedo { get; set; }
+    public string? Normal { get; set; }
+    public string? Detail { get; set; }
+    public string? Lightmap { get; set; }
+    public string? SpecularRoughness { get; set; }
+    public string? Emissive { get; set; }
+    public string? OpacityMask { get; set; }
+    public bool TwoSided { get; set; }
+    public float Opacity { get; set; } = 1f;
+    public float Gloss { get; set; }
+    public float Roughness { get; set; } = 1f;
+    public float Metallic { get; set; }
+    public float SpecularStrength { get; set; }
+    public float ReflectionStrength { get; set; }
+    public float EmissiveStrength { get; set; } = 1f;
+    public UniversalUvTransform Uv0 { get; set; } = new();
+    public UniversalMaterialAnimation? Animation { get; set; }
