+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+
+namespace MphRead.Mods.MapGen.Universal;
+
+public sealed record UniversalImportOptions(
+    float Scale = 1f,
+    bool FlipWinding = false,
+    bool ZUp = false,
+    bool FlipUvVertical = true,
+    ModelCollisionMode Collision = ModelCollisionMode.Companion);
+
+public sealed record UniversalImportResult(UniversalMap Map, IReadOnlyDictionary<string, byte[]> Assets, IReadOnlyDictionary<string, string> AssetSources, IReadOnlyList<string> Dependencies);
+
+public interface IUniversalMapAdapter
+{
+    string Id { get; }
+    string DisplayName { get; }
+    int FidelityTier { get; }
+    IReadOnlyCollection<string> Extensions { get; }
+    bool CanImport(string path);
+    UniversalImportResult Import(string path, UniversalImportOptions options, CancellationToken cancellation = default);
+}
+
+/// <summary>
+/// Shared adapter registry. Game-specific decoders remain thin and terminate
+/// at UniversalMap instead of writing Project Prime runtime data directly.
+/// </summary>
+public static class UniversalMapImportService
+{
+    private static readonly List<IUniversalMapAdapter> _adapters = new()
+    {
+        new ExistingModelUniversalAdapter()
+    };
+
+    public static IReadOnlyList<IUniversalMapAdapter> Adapters => _adapters;
+
+    public static void Register(IUniversalMapAdapter adapter)
+    {
+        ArgumentNullException.ThrowIfNull(adapter);
+        if (_adapters.Any(existing => string.Equals(existing.Id, adapter.Id, StringComparison.OrdinalIgnoreCase)))
+            throw new InvalidOperationException($"A UniversalMap adapter named '{adapter.Id}' is already registered.");
+        _adapters.Add(adapter);
+    }
+
+    public static IUniversalMapAdapter Resolve(string path)
+    {
+        path = Path.GetFullPath(path);
+        return _adapters.FirstOrDefault(adapter => adapter.CanImport(path))
+            ?? throw new InvalidDataException($"No UniversalMap adapter supports '{Path.GetExtension(path)}'.");
+    }
+
+    public static UniversalImportResult Import(string path, UniversalImportOptions options, CancellationToken cancellation = default)
+        => Resolve(path).Import(path, options, cancellation);
+}
