+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+
+namespace MphRead.Mods.MapGen.Universal;
+
+public static class UniversalMapValidator
+{
+    public static IReadOnlyList<UniversalDiagnostic> Validate(UniversalMap map)
+    {
+        ArgumentNullException.ThrowIfNull(map);
+        var diagnostics = new List<UniversalDiagnostic>();
+        var all = map.RenderMeshes.Concat(map.CollisionMeshes).ToArray();
+        var ids = new HashSet<Guid>();
+        foreach (var mesh in all)
+        {
+            if (!ids.Add(mesh.Id)) diagnostics.Add(Error("UMAP-GEO-001", $"Duplicate mesh id {mesh.Id}.", mesh.Name));
+            if (mesh.Vertices.Count == 0 || mesh.Faces.Count == 0) diagnostics.Add(Error("UMAP-GEO-002", "Mesh has no usable faces.", mesh.Name));
+            for (int i = 0; i < mesh.Vertices.Count; i++)
+            {
+                var v = mesh.Vertices[i];
+                if (v.Length != 3 || v.Any(x => !float.IsFinite(x))) diagnostics.Add(Error("UMAP-GEO-003", $"Vertex {i} is not a finite XYZ position.", mesh.Name));
+            }
+            for (int i = 0; i < mesh.Faces.Count; i++)
+            {
+                var f = mesh.Faces[i];
+                if (f.Length < 3 || f.Any(index => index < 0 || index >= mesh.Vertices.Count))
+                {
+                    diagnostics.Add(Error("UMAP-GEO-004", $"Face {i} has invalid indices.", mesh.Name));
+                    continue;
+                }
+                if (f.Length == 3)
+                {
+                    Vector3 a = V(mesh.Vertices[f[0]]), b = V(mesh.Vertices[f[1]]), c = V(mesh.Vertices[f[2]]);
+                    if (Vector3.Cross(b - a, c - a).LengthSquared() < 1e-10f)
+                        diagnostics.Add(Error("UMAP-GEO-005", $"Face {i} is degenerate.", mesh.Name));
+                }
+            }
+            if (mesh.FaceMaterials.Count != 0 && mesh.FaceMaterials.Count != mesh.Faces.Count)
+                diagnostics.Add(Error("UMAP-MAT-001", "Face material count does not match face count.", mesh.Name));
+            foreach (int material in mesh.FaceMaterials)
+                if (material < 0 || material >= map.Materials.Count) diagnostics.Add(Error("UMAP-MAT-002", $"Material index {material} is out of range.", mesh.Name));
+            if (mesh.FaceUv0.Count != 0 && mesh.FaceUv0.Count != mesh.Faces.Count)
+                diagnostics.Add(Error("UMAP-UV-001", "UV0 face count does not match geometry face count.", mesh.Name));
+        }
+        if (map.RenderMeshes.Count > 0 && map.CollisionMeshes.Count == 0 && map.RenderMeshes.All(m => !m.Solid))
+            diagnostics.Add(new UniversalDiagnostic { Code = "UMAP-COL-001", Severity = "warning", Message = "Map contains render meshes but no player-blocking collision." });
+        return diagnostics;
+    }
+
+    private static Vector3 V(float[] v) => new(v[0], v[1], v[2]);
+    private static UniversalDiagnostic Error(string code, string message, string source) => new() { Code = code, Severity = "error", Message = message, SourceObject = source };
+}